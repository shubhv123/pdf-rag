# ──────────────────────────────────────────────
# HuggingFace Inference API
# Get your token at https://huggingface.co/settings/tokens
# ──────────────────────────────────────────────
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM model served via HuggingFace Inference API
# Options (free tier):
#   google/flan-t5-base          (fast, small)
#   google/flan-t5-large         (better quality)
#   mistralai/Mistral-7B-Instruct-v0.2  (high quality, slower)
LLM_MODEL_ID=google/flan-t5-base

# Embedding model (runs locally, no API needed)
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval — number of top-k chunks to fetch
TOP_K=4

# Upload directory
UPLOAD_DIR=uploads

# Vector store directory
VECTOR_STORE_DIR=vector_store
